# Maintainer: CR(g) OS / Atlas OS project
#
# armada's own patched gamescope, ported from armada-packages/gamescope's
# Fedora RPM spec to a real Arch PKGBUILD. Verified 2026-07-24: this exact
# recipe (source, pinned commits, patches, meson flags) builds cleanly on
# Arch Linux ARM aarch64 via a manual meson/ninja run - see
# libhybris/docs/ARCHITECTURE.md and libhybris/logs/2026-07-24.md for the
# full verification trail. This PKGBUILD exists to turn that verified
# manual build into a real, pacman-tracked package (see
# libhybris/docs/TECHNICAL_DEBT.md, Priority B) - not yet run through
# makepkg end-to-end, see the note at the bottom.

pkgname=gamescope-armada
_pkgname=gamescope
pkgver=3.16.24
pkgrel=1
pkgdesc="SteamOS session compositing window manager, with armada's RP6/ROCKNIX patches (rotation shader, DRM fake-output-mm, gamepad cursor fix)"
arch=(aarch64)
url="https://github.com/ValveSoftware/gamescope"
license=(BSD-2-Clause BSD-3-Clause LicenseRef-Reshade)
depends=(
  glibc libstdc++ libgcc lcms2 libavif 'libcap.so' libdecor libdrm libei
  libinput 'libpipewire-0.3.so' libx11 libxcb libxcomposite libxcursor
  libxdamage libxext libxfixes libxi 'libxkbcommon.so' libxmu libxrender
  libxres libxtst libxxf86vm luajit pixman sdl2 seatd systemd-libs
  vulkan-icd-loader wayland xcb-util-errors xcb-util-wm xorg-server-xwayland
  wlroots0.18 libliftoff hwdata libdisplay-info
)
makedepends=(
  benchmark cmake git glslang meson ninja vulkan-headers wayland-protocols
  catch2 glm stb spirv-headers openvr
)
provides=(gamescope)
conflicts=(gamescope)

_reshade_commit=696b14cd6006ae9ca174e6164450619ace043283
_vkroots_commit=5106d8a0df95de66cc58dc1ea37e69c99afc9540
# Pinned submodule commits for this exact gamescope tag (from GitHub's
# tree API for tag 3.16.24, not guessed) - vendored as real tarballs
# instead of relying on meson's wrap auto-fetch, which arch-meson's
# --wrap-mode=nodownload disables (found the hard way, see
# logs/2026-07-24.md).
_wlroots_commit=c08d99437ec8bb56a703f04ad1ef199502c62d10
_libliftoff_commit=8b08dc1c14fd019cc90ddabe34ad16596b0691f4

source=(
  "${_pkgname}-${pkgver}.tar.gz::https://github.com/ValveSoftware/gamescope/archive/refs/tags/${pkgver}.tar.gz"
  "reshade-${_reshade_commit:0:7}.tar.gz::https://github.com/misyltoad/reshade/archive/${_reshade_commit}/reshade-${_reshade_commit:0:7}.tar.gz"
  "vkroots-${_vkroots_commit:0:7}.tar.gz::https://github.com/misyltoad/vkroots/archive/${_vkroots_commit}/vkroots-${_vkroots_commit:0:7}.tar.gz"
  "wlroots-${_wlroots_commit:0:7}.tar.gz::https://github.com/Joshua-Ashton/wlroots/archive/${_wlroots_commit}/wlroots-${_wlroots_commit:0:7}.tar.gz"
  "libliftoff-${_libliftoff_commit:0:7}.tar.gz::https://gitlab.freedesktop.org/emersion/libliftoff/-/archive/${_libliftoff_commit}/libliftoff-${_libliftoff_commit}.tar.gz"
  "stb_image_resize.h::https://raw.githubusercontent.com/nothings/stb/master/deprecated/stb_image_resize.h"
  stb.pc
  0001-cstdint.patch
  Use-system-stb-glm.patch
  0004-DRMBackend-Add-GAMESCOPE_FAKE_OUTPUT_MM-env-to-set-c.patch
  0005-feature-add-rotation-shader-for-rotating-output.patch
  0006-steamcompmgr-fix-gamepad-cursor-sprite-frozen-via-XTest.patch
  Allow-to-use-system-wlroots.patch
)
