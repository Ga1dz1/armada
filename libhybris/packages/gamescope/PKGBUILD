prepare() {
  cd "${_pkgname}-${pkgver}"

  mkdir -p pkgconfig
  cp "${srcdir}/stb.pc" pkgconfig/stb.pc

  # System spirv-headers instead of the vendored thirdparty/ copy.
  sed -i 's^../thirdparty/SPIRV-Headers/include/spirv/^/usr/include/spirv/^' src/meson.build

  mkdir -p src/reshade subprojects/vkroots subprojects/wlroots subprojects/libliftoff
  tar -xzf "${srcdir}/reshade-${_reshade_commit:0:7}.tar.gz" --strip-components=1 -C src/reshade
  tar -xzf "${srcdir}/vkroots-${_vkroots_commit:0:7}.tar.gz" --strip-components=1 -C subprojects/vkroots
  tar -xzf "${srcdir}/wlroots-${_wlroots_commit:0:7}.tar.gz" --strip-components=1 -C subprojects/wlroots
  tar -xzf "${srcdir}/libliftoff-${_libliftoff_commit:0:7}.tar.gz" --strip-components=1 -C subprojects/libliftoff

  for p in 0001-cstdint.patch Use-system-stb-glm.patch \
           0004-DRMBackend-Add-GAMESCOPE_FAKE_OUTPUT_MM-env-to-set-c.patch \
           0005-feature-add-rotation-shader-for-rotating-output.patch \
           0006-steamcompmgr-fix-gamepad-cursor-sprite-frozen-via-XTest.patch \
           Allow-to-use-system-wlroots.patch; do
    patch -p1 < "${srcdir}/${p}"
  done
}

build() {
  cd "${_pkgname}-${pkgver}"

  # Real fix, found 2026-07-24: Arch's stb package only ships
  # stb_image_resize2.h (upstream renamed/rewrote it); this gamescope
  # version's source still wants the old stb_image_resize.h. Drop the
  # exact same file from stb's own upstream repo alongside the real
  # system headers for this build only (not installed system-wide).
  install -Dm644 "${srcdir}/stb_image_resize.h" "${srcdir}/stb-compat/stb_image_resize.h"

  export PKG_CONFIG_PATH="${srcdir}/${_pkgname}-${pkgver}/pkgconfig"
  export CPPFLAGS="${CPPFLAGS:-} -I${srcdir}/stb-compat"

  arch-meson . build \
    -Davif_screenshots=enabled \
    -Dbenchmark=enabled \
    -Ddrm_backend=enabled \
    -Denable_gamescope=true \
    -Denable_gamescope_wsi_layer=true \
    -Denable_openvr_support=true \
    -Dforce_fallback_for=wlroots,libliftoff,vkroots \
    -Dinput_emulation=enabled \
    -Dpipewire=enabled \
    -Drt_cap=enabled \
    -Dsdl2_backend=enabled
  meson compile -C build
}

package() {
  cd "${_pkgname}-${pkgver}"
  DESTDIR="${pkgdir}" meson install -C build --skip-subprojects
  install -Dm644 LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}/"
}

# NOTE, added 2026-07-24: this PKGBUILD encodes the exact recipe already
# verified working via a manual `meson setup` + `ninja` run in
# libhybris/src/atlas-base/rootfs/build/gamescope-src (see
# logs/2026-07-24.md) - same source, same pinned commits, same patches,
# same meson flags, same stb_image_resize.h fix. It has NOT yet been run
# through `makepkg` itself end-to-end (checksums are all SKIP, and
# makepkg's own sandboxing/fakeroot behavior can surface issues a manual
# root-shell build doesn't hit). Running `makepkg -g` to fill in real
# checksums, then a real `makepkg` build, is the next concrete step - see
# libhybris/docs/TECHNICAL_DEBT.md.
