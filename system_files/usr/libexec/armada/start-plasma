#!/usr/bin/bash
set -euo pipefail

export DESKTOP_SESSION=plasma
export XDG_CURRENT_DESKTOP=KDE
export XDG_SESSION_DESKTOP=KDE
export XDG_SESSION_TYPE=wayland
export KDE_SESSION_VERSION=6

# Ensure the KDE XDG desktop portal backend is available before Plasma/Steam
# asks for a file chooser. In some boot paths the systemd user session does not
# auto-activate plasma-xdg-desktop-portal-kde.service in time.
if ! pgrep -x xdg-desktop-portal-kde >/dev/null 2>&1; then
    systemctl --user start plasma-xdg-desktop-portal-kde.service 2>/dev/null || \
        /usr/libexec/xdg-desktop-portal-kde &
fi

# Keep game-mode and Plasma desktop brightness in sync. Plasma 6 PowerDevil
# picks a different backlight device than gamescope/DRM on RP6.
/usr/libexec/armada/armada-brightness-sync &

exec /usr/bin/startplasma-wayland
